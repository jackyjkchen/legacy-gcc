diff --git a/gcc/testsuite/g++.dg/cpp0x/pr123818.C b/gcc/testsuite/g++.dg/cpp0x/pr123818.C
new file mode 100644
index 000000000..bb0b03c2d
--- /dev/null
+++ b/gcc/testsuite/g++.dg/cpp0x/pr123818.C
@@ -0,0 +1,24 @@
+// PR c++/123818
+// { dg-do run { target c++11 } }
+
+struct A { A (int x) : a (x) {} int a; };
+struct B { A b; };
+
+int
+foo (B x = B { 42 })
+{
+    return x.b.a;
+}
+
+int
+bar (B x = B { 43 })
+{
+    return x.b.a;
+}
+
+int
+main ()
+{
+  if (foo () != bar () - 1)
+    __builtin_abort ();
+}

From 2d8557e0a3479db551fc9d074f1e0ba444ea9cf5 Mon Sep 17 00:00:00 2001
From: Achim Gratz <Achim.Gratz@Stromeko.DE>
Date: Mon, 10 Feb 2025 18:45:54 +0100
Subject: [PATCH 401/403] fix build: gcc/opts.cc

---
 gcc/opts.cc | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/gcc/opts.cc b/gcc/opts.cc
index 6658b6acd37..c4a57af71fa 100644
--- a/gcc/opts.cc
+++ b/gcc/opts.cc
@@ -1795,8 +1795,11 @@ print_filtered_help (unsigned int include_flags,
 		      sizeof new_help - strlen (new_help),
 		      "  %s", _(use_diagnosed_msg));
 	  else
+#pragma GCC diagnostic push
+#pragma GCC diagnostic ignored "-Wformat-truncation"
 	    snprintf (new_help, sizeof new_help,
 		      "%s  %s", help, _(use_diagnosed_msg));
+#pragma GCC diagnostic pop
 
 	  help = new_help;
 	}
